# --- LLM ---
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.5-flash-litea
LLM_TEMPERATURE=0.2

# --- Voice (interfaces/voice_app.py, api/routers/voice.py) ---
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# "Rachel" — one of ElevenLabs' premade voices, available on every account.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Database ---
DATABASE_URL=sqlite:///./electronics_shop.db
# To move to Postgres later, change this to:
# postgresql://user:pass@localhost:5432/electronics_shop
# (and pip install psycopg2-binary)

# --- Chroma ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Escalation ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# --- Optional: fallback web search for specs ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- Optional: real catalog data via scripts/import_from_mouser.py ---
# NOTE: this needs a Search API key specifically, requested via the separate
# "Search API Request Form" in My Mouser -> APIs -- a key generated from the
# general APIs section is an Order/Cart key and will NOT work here.
# https://www.mouser.com/api-search/
MOUSER_API_KEY=your-mouser-search-api-key-here

# --- Optional: real catalog data via scripts/import_from_nexar.py ---
# Free, self-service OAuth2 app (no approval wait) from https://portal.nexar.com/
# -> Applications -> New Application -> "supply.domain" scope.
NEXAR_CLIENT_ID=your-nexar-client-id-here
NEXAR_CLIENT_SECRET=your-nexar-client-secret-here

# --- Admin panel (/admin) ---
# Shared password for the admin panel. Leave empty to disable it entirely.
ADMIN_PASSWORD=
